# -------------------------------------------------------
# OBSTACLES  (added – do NOT remove)
# -------------------------------------------------------

# OBSTACLE 1 – Stopped red vehicle on segment v3_3 (WP 13→18, road x=0, y=0..100)
# Placed at (0, 50) – squarely in the centre of that road segment.
Solid {
  translation 0 50 0.75
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.8 0.1 0.1
        roughness 0.8
        metalness 0.2
      }
      geometry Box {
        size 4.5 4.0 1.5
      }
    }
  ]
  name "obstacle_stopped_vehicle"
  boundingObject Box {
    size 4.5 4.0 1.5
  }
}

# OBSTACLE 2 – Orange road barrier on segment h3_3 (WP 13→14, road y=0, x=0..100)
# Placed at (50, 0) – blocking the horizontal road.
Solid {
  translation 50 0 0.75
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.5 0.0
        roughness 1.0
        metalness 0.0
      }
      geometry Box {
        size 0.4 9.0 1.5
      }
    }
  ]
  name "obstacle_road_barrier"
  boundingObject Box {
    size 0.4 9.0 1.5
  }
}

# OBSTACLE 3 – Grey debris / rubble on segment h4_2 (WP 17→18, road y=100, x=-100..0)
# Placed at (-50, 100) – forcing a detour on the upper-left road.
Solid {
  translation -50 100 0.75
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.5 0.5 0.5
        roughness 1.0
        metalness 0.0
      }
      geometry Box {
        size 5.0 5.0 1.5
      }
    }
  ]
  name "obstacle_debris"
  boundingObject Box {
    size 5.0 5.0 1.5
  }
}
